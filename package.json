{
  "name": "aggregitor",
  "version": "0.1.0",
  "description": "Generate aggregated git commit logs from multiple git folders",
  "bin": {
    "aggregitor": "dist/index.js"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/index.js",
    "start": "node dist/index.js"
  },
  "keywords": [
    "git",
    "log",
    "aggregate",
    "commit",
    "changelog"
  ],
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "js-yaml": "^5.2.0",
    "typescript": "^5.7.0"
  }
}
